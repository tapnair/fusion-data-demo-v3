# Copy to .env and fill in real values. .env is gitignored.

# APS access token — paste from your browser session.
# 1. Sign in to the SPA (http://localhost:5173 or the GitHub Pages URL)
# 2. DevTools → Application → Session Storage → localhost:5173
# 3. Look for a key like `aps_access_token` and copy its value here
# 4. Token is valid ~1 hour. Re-grab if you see 401s.
APS_ACCESS_TOKEN=

# MFG DM GraphQL endpoint (production)
GRAPHQL_ENDPOINT=https://developer.api.autodesk.com/mfg/v3/graphql/public

# Mongo connection — use the erp_seeder user (readWrite on fusion_erp_demo)
MONGO_CONNECTION_STRING=mongodb+srv://erp_seeder:<password>@tapnair-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=fusion_erp_demo
MONGO_COLLECTION=materials
